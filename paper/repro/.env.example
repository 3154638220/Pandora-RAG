# 第一阶段默认：Llama-3.1-8B-Instruct（OpenAI 兼容推理服务，如 vLLM）
# 权重预下载：python scripts/download_stage1_assets.py --model
# vLLM 示例：
#   python -m vllm.entrypoints.openai.api_server \
#     --model models/Meta-Llama-3.1-8B-Instruct \
#     --served-model-name meta-llama/Meta-Llama-3.1-8B-Instruct
#
# Linux：若启动 vLLM 报 libstdc++.so.6 / CXXABI_1.3.15（经 sqlite3/ICU），请先让 conda 的 lib 在 LD_LIBRARY_PATH 最前：
#   export LD_LIBRARY_PATH="$CONDA_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# 详见 ../../docs/active/experiments.md「vLLM（Linux）与 libstdc++ / LD_LIBRARY_PATH」。
OPENAI_API_BASE=http://127.0.0.1:8000/v1
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# 本地服务若不要求鉴权可填占位；OpenAI 官方云请填真实 sk
OPENAI_API_KEY=EMPTY

# Ollama：ollama pull llama3.1:8b 后改为
# OPENAI_API_BASE=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# 拉取 Meta  gated 权重需在 https://huggingface.co/meta-llama 接受协议并设置：
# export HF_TOKEN=hf_xxx

# 数据与权重默认在仓库内：data/、models/、checkpoints/、logs/（勿再指向已删除的外盘路径）。
# 若 Llama 权重仅放在其它目录：export PANDORA_MODELS_ROOT=/path/to/models

# Hugging Face 缓存：运行 stage1 / download_stage1_assets / step1_collect_trajectories 时，
# 默认强制为仓库根目录下 .hf_cache（与下方绝对路径一致）。若需沿用 shell 里已导出的 HF_HOME，请设置：
# export PANDORA_USE_SYSTEM_HF_HOME=1
HF_HOME=/home/x12dpg/hjx/Pandora-RAG/.hf_cache

# Stage1 迭代检索（默认 bm25）。改用 Contriever-MS MARCO + bge-reranker-v2-m3：
# export PANDORA_RETRIEVER_BACKEND=contriever_bge
# export PANDORA_CONTRIEVER_MODEL=facebook/contriever-msmarco
# export PANDORA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 高吞吐：检索/精排独占一张 GPU，勿与 vLLM、HiddenStateExtractor 同卡（示例 cuda:3）：
# export RETRIEVER_DEVICE=cuda:3
# 并行轨迹线程数（也可用 CLI --num-workers）：
# export PANDORA_NUM_WORKERS=8
# 跳过每步 self-eval HTTP（self_eval_score=0；见 ../../docs/active/experiments.md）：
# export PANDORA_STAGE1_SKIP_SELF_EVAL=1
# 当前主线 Stage1 默认使用单次确定性生成：temperature=0.0, n=1。
# 对齐 Stop-RAG 时，统一口径还包括：max_iterations=5、repeat_size=1、context length=2048。
# 推荐完整命令见 ../../docs/active/experiments.md「推荐：多卡上的 vLLM + Stage1（Contriever+BGE、高吞吐，避免踩坑）」。
# python -m stage1.run_stage1 --retriever-backend contriever_bge --skip-self-eval --num-workers 8
